---
import HeroPanel from '../components/HeroPanel.tsx'
import '../styles/landing.css'
// Preload the latin subsets so Geist arrives before first paint — no swap, no reflow.
import geistSans from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url'
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url'

const REPO = 'https://github.com/kemalilketuna/Navvy'
const INSTALL = `${REPO}/releases`
const DOCS = '/docs'

// Demo playlist — privacy-friendly nocookie embed, lazy-loaded below the hero.
const DEMO_PLAYLIST = 'PL3w1iL2KiYZjMI2QqM8z9AwJs68g1XMVO'
const DEMO_EMBED = `https://www.youtube-nocookie.com/embed/videoseries?list=${DEMO_PLAYLIST}`
const DEMO_PLAYLIST_URL = `https://www.youtube.com/playlist?list=${DEMO_PLAYLIST}`

// The agent's full action vocabulary — one is chosen, by element index, each step.
const actions = [
	'Click',
	'Type',
	'Select an option',
	'Scroll',
	'Scroll sideways',
	'Press keys',
	'Find text on the page',
	'Go back',
	'Drag & drop',
	'Open a tab',
	'Switch tabs',
	'Close a tab',
	'Ask you a question',
	'Wait',
	'Run JavaScript',
]

const features = [
	{
		idx: '01',
		title: 'Browser automation',
		body: 'Describe a task in plain language. Navvy reads the page, assigns every interactive element an index, and performs the clicks, typing, and navigation — on sites it has never seen before.',
		link: `${DOCS}/introduction/overview`,
	},
	{
		idx: '02',
		title: 'Works on any website',
		body: 'No brittle, hand-written selectors. Navvy re-reads the live page each step and simulates real pointer and keyboard events — so even React- and antd-controlled inputs accept its clicks and typing.',
		link: `${DOCS}/internals/action-execution`,
	},
	{
		idx: '03',
		title: 'One task, many tabs',
		body: 'Navvy opens new tabs, switches between them, and closes them on its own — gathering every tab a job touches into one named group so a multi-step task stays organised.',
		link: `${DOCS}/features/multi-tab`,
	},
	{
		idx: '04',
		title: 'Skills you can teach',
		body: 'Show Navvy a workflow once, by voice or text, and it saves a reusable, parameterised command. Each replay is re-planned from scratch, so it keeps working even as the page drifts.',
		link: `${DOCS}/features/skills`,
	},
	{
		idx: '05',
		title: 'Bring your own model',
		body: 'Point Navvy at any of 17 providers or a custom endpoint. Keys are encrypted at rest and never leave your machine — or start with the built-in demo and no key at all.',
		link: `${DOCS}/features/models`,
	},
	{
		idx: '06',
		title: 'Talk to it, hands-free',
		body: 'Hold a key to speak, release to send, and hear answers read back. Choose your speech-to-text and text-to-speech providers, or use the built-in Web Speech engine with no API key at all.',
		link: `${DOCS}/features/voice`,
	},
	{
		idx: '07',
		title: 'Your secrets never leave the page',
		body: 'Save a card number or password once — stored locally and encrypted at rest. Navvy types it straight into the form while the model only ever sees an opaque {{token}}.',
		link: `${DOCS}/features/data-masking`,
	},
	{
		idx: '08',
		title: 'One key to stop, one key to talk',
		body: 'Press Esc to cancel a running task; hold ` to talk. Both are single keys you can rebind, working across the page and the side panel alike.',
		link: `${DOCS}/features/shortcuts`,
	},
]

const steps = [
	{ label: 'Read', body: 'The live DOM is extracted into a compact, indexed map of the page.' },
	{ label: 'Simplify', body: 'It is dehydrated into model-ready text — small enough to reason over.' },
	{ label: 'Plan', body: 'The model picks the next action by element index: click 7, type into 3.' },
	{ label: 'Act', body: 'Navvy performs it on the real page, then re-reads and repeats.' },
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" href={geistSans} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/logo.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/128.png" />
		<title>Navvy — the browser agent that does the clicking</title>
		<meta
			name="description"
			content="Navvy is an AI agent that drives your browser. Tell it what to do in plain language — it reads the page and does the clicking, typing, and navigation for you."
		/>
		<meta property="og:title" content="Navvy — the browser agent" />
		<meta property="og:description" content="Tell your browser what to do. It does the clicking." />
		<meta property="og:image" content="/128.png" />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<!-- Header -->
		<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
			<a href="/" class="flex items-center gap-2.5">
				<img src="/logo.svg" alt="" width="30" height="30" />
				<span class="text-lg font-semibold tracking-tight">Navvy</span>
			</a>
			<nav class="flex items-center gap-1 text-sm">
				<a href="#demo" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">Demo</a>
					<a href="#actions" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">Actions</a>
					<a href="#features" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">Features</a>
				<a href="#how" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">How it works</a>
				<a href={DOCS} class="rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink">Docs</a>
				<a href={REPO} class="rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink">GitHub</a>
				<a
					href={INSTALL}
					class="ml-2 rounded-lg bg-[var(--color-amber)] px-4 py-2 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
					>Install</a
				>
			</nav>
		</header>

		<!-- Hero -->
		<section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-6 pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:pt-10">
			<div>
				<p class="mb-5 inline-flex items-center gap-2 rounded-full border border-cream-200 bg-cream-100 px-3 py-1 font-mono text-xs text-ink-muted">
					<span class="inline-block size-1.5 rounded-full bg-[var(--color-amber)]"></span>
					Browser agent · Chrome extension
				</p>
				<h1 class="text-balance text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
					Tell your browser what to do.<br />
					<span class="text-[var(--color-amber-deep)]">It does the clicking.</span>
				</h1>
				<p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted">
					Navvy reads any page, decides what to do, and carries out the clicks, typing, and
					navigation for you — by voice or by text, right next to your tabs.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a
						href={INSTALL}
						class="rounded-lg bg-[var(--color-amber)] px-5 py-3 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
						>Add to Chrome</a
					>
					<a href={DOCS} class="rounded-lg border border-cream-200 bg-white/40 px-5 py-3 font-medium text-ink transition-colors hover:bg-white/70">
						Read the docs →
					</a>
				</div>
			</div>

			<!-- The Navvy mark + idle slogan, lifted straight from the extension -->
			<HeroPanel client:load />
		</section>

		<!-- Demo: the product in motion, straight from the YouTube playlist -->
		<section id="demo" class="mx-auto max-w-6xl px-6 pb-20">
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<h2 class="max-w-xl text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
						See Navvy in action.
					</h2>
					<p class="mt-3 max-w-lg text-ink-muted">
						A short playlist of real tasks — watch Navvy read each page and do the clicking,
						typing, and navigating itself.
					</p>
				</div>
				<a href={DEMO_PLAYLIST_URL} class="font-medium text-[var(--color-amber-deep)] underline-offset-4 hover:underline">
					Watch on YouTube →
				</a>
			</div>
			<div class="mt-10 overflow-hidden rounded-2xl border border-cream-200 bg-ink shadow-sm">
				<div class="aspect-video">
					<iframe
						class="size-full"
						src={DEMO_EMBED}
						title="Navvy demo playlist"
						loading="lazy"
						referrerpolicy="strict-origin-when-cross-origin"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						allowfullscreen></iframe>
				</div>
			</div>
		</section>

		<!-- Actions: the full toolset as a compact chip grid -->
		<section id="actions" class="border-y border-cream-200 bg-cream-100/60">
			<div class="mx-auto max-w-6xl px-6 py-16">
				<h2 class="max-w-xl text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
					One vocabulary for the whole web.
				</h2>
				<p class="mt-3 max-w-lg text-ink-muted">
					Every step, Navvy picks exactly one action by element index and runs it on the real page. This is the entire toolset — the same handful of moves operate any site.
				</p>
				<ul class="mt-10 flex flex-wrap gap-2.5">
					{
						actions.map((a) => (
							<li class="inline-flex items-center gap-2 rounded-full border border-cream-200 bg-white/50 px-3.5 py-1.5 font-mono text-sm text-ink">
								<span class="inline-block size-1.5 rounded-full bg-[var(--color-amber)]" />
								{a}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- Features: the standout capabilities, as editorial cards -->
		<section id="features" class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="max-w-xl text-balance text-3xl font-semibold tracking-tight sm:text-4xl">
				The whole agent, in a side panel.
			</h2>
			<p class="mt-3 max-w-lg text-ink-muted">No separate app, no remote sandbox — Navvy works where you already browse.</p>

			<div class="mt-12 grid gap-5 sm:grid-cols-2">
				{
					features.map((f) => (
						<div class="flex flex-col rounded-2xl border border-cream-200 bg-white/40 p-7 transition-colors hover:bg-white/70">
							<span class="font-mono text-xs text-[var(--color-amber-deep)]">{f.idx}</span>
							<h3 class="mt-2 text-xl font-semibold tracking-tight">{f.title}</h3>
							<p class="mt-3 leading-relaxed text-ink-muted">{f.body}</p>
							<a href={f.link} class="mt-4 inline-block font-medium text-[var(--color-amber-deep)] underline-offset-4 hover:underline">
								Learn more →
							</a>
						</div>
					))
				}
			</div>
		</section>

		<!-- How it works: a connected stepper, no cards -->
		<section id="how" class="border-y border-cream-200 bg-cream-100/60">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="text-3xl font-semibold tracking-tight">How it reads a page</h2>
				<p class="mt-3 max-w-lg text-ink-muted">A perception–reasoning–action loop that works without brittle, hand-written selectors.</p>
				<ol class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
					{
						steps.map((s, i) => (
							<li class="relative pl-0">
								<div class="flex items-center gap-3">
									<span class="grid size-8 shrink-0 place-items-center rounded-full bg-[var(--color-amber)] font-mono text-sm font-semibold text-cream">
										{i + 1}
									</span>
									<span class="h-px flex-1 bg-cream-200" />
								</div>
								<h3 class="mt-4 text-lg font-semibold tracking-tight">{s.label}</h3>
								<p class="mt-1.5 text-sm leading-relaxed text-ink-muted">{s.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Privacy callout: borderless, with the token contrast -->
		<section class="mx-auto max-w-6xl px-6 py-24">
			<div class="grid items-center gap-10 lg:grid-cols-[1fr_1.05fr]">
				<div>
					<h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Privacy is the default.</h2>
					<p class="mt-4 max-w-md leading-relaxed text-ink-muted">
						Sensitive values you save are stored locally and encrypted at rest. With data masking on, the
						real value is typed into the page but the model only ever receives a placeholder token — so
						your card number, password, or anything you mark sensitive never reaches the provider.
					</p>
				</div>
				<div class="rounded-2xl border border-cream-200 bg-white p-6 font-mono text-sm leading-relaxed shadow-sm">
					<div class="text-ink-muted">// what the model receives</div>
					<div class="mt-2">card number: <span class="text-[var(--color-amber-deep)]">{'{{credit_card}}'}</span></div>
					<div class="mt-5 text-ink-muted">// what lands in the page</div>
					<div class="mt-2">card number: •••• •••• •••• 4242</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="mx-auto max-w-6xl px-6 pb-24">
			<div class="rounded-3xl bg-ink px-10 py-16 text-center text-cream">
				<h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Stop doing the clicking.</h2>
				<p class="mx-auto mt-4 max-w-md text-cream-200/80">Install Navvy and hand the boring parts of the browser to an agent that actually understands the page.</p>
				<a
					href={INSTALL}
					class="mt-8 inline-block rounded-lg bg-[var(--color-amber)] px-6 py-3 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
					>Add to Chrome</a
				>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-cream-200">
			<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-ink-muted sm:flex-row">
				<div class="flex items-center gap-2">
					<img src="/logo.svg" alt="" width="20" height="20" />
					<span>Navvy</span>
				</div>
				<nav class="flex items-center gap-5">
					<a href={DOCS} class="transition-colors hover:text-ink">Docs</a>
					<a href={REPO} class="transition-colors hover:text-ink">GitHub</a>
					<a href="/docs/legal/terms-and-privacy" class="transition-colors hover:text-ink">Terms &amp; Privacy</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
