---
import '../styles/landing.css'

const REPO = 'https://github.com/kemalilketuna/Navvy'
const INSTALL = `${REPO}/releases`
const DOCS = '/docs'

const capabilities = [
	{
		idx: '01',
		title: 'Browser automation',
		body: 'Describe a task in plain language. Navvy reads the page and performs the clicks, typing, and navigation — on sites it has never seen before.',
	},
	{
		idx: '02',
		title: 'Voice mode',
		body: 'Hold a key to talk, release to send, and hear answers back. Configurable speech providers, plus a free in-browser fallback.',
	},
	{
		idx: '03',
		title: 'Data masking',
		body: 'Save sensitive values locally — encrypted at rest. Navvy fills them into forms while the real values never reach the model.',
	},
	{
		idx: '04',
		title: 'Teach → Skills',
		body: 'Narrate an automation once. Navvy refines it into a reusable, parameterized skill it can run again on any matching page.',
	},
]

const steps = [
	{ k: 'read', label: 'Read', body: 'The live DOM is extracted into a compact, indexed map of the page.' },
	{ k: 'simplify', label: 'Simplify', body: 'It is dehydrated into model-ready text — small enough to reason over.' },
	{ k: 'plan', label: 'Plan', body: 'The model picks the next action by element index: click 7, type into 3.' },
	{ k: 'act', label: 'Act', body: 'Navvy performs it on the real page, then re-reads and repeats.' },
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/logo.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/128.png" />
		<title>Navvy — the browser agent that does the clicking</title>
		<meta
			name="description"
			content="Navvy is an AI agent that drives your browser. Tell it what to do in plain language — it reads the page and does the clicking, typing, and navigation for you."
		/>
		<meta property="og:title" content="Navvy — the browser agent" />
		<meta property="og:description" content="Tell your browser what to do. It does the clicking." />
		<meta property="og:image" content="/128.png" />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<!-- Header -->
		<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
			<a href="/" class="flex items-center gap-2.5">
				<img src="/logo.svg" alt="" width="30" height="30" />
				<span class="text-lg font-semibold tracking-tight">Navvy</span>
			</a>
			<nav class="flex items-center gap-1 text-sm">
				<a href="#capabilities" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">Capabilities</a>
				<a href="#how" class="hidden rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink sm:block">How it works</a>
				<a href={DOCS} class="rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink">Docs</a>
				<a href={REPO} class="rounded-md px-3 py-2 text-ink-muted transition-colors hover:text-ink">GitHub</a>
				<a
					href={INSTALL}
					class="ml-2 rounded-lg bg-[var(--color-amber)] px-4 py-2 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
					>Install</a
				>
			</nav>
		</header>

		<!-- Hero -->
		<section class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-12 pb-20 lg:grid-cols-[1.05fr_1fr] lg:pt-20">
			<div>
				<p class="mb-5 inline-flex items-center gap-2 rounded-full border border-cream-200 bg-cream-100 px-3 py-1 font-mono text-xs text-ink-muted">
					<span class="inline-block size-1.5 rounded-full bg-[var(--color-amber)]"></span>
					Browser agent · Chrome extension
				</p>
				<h1 class="text-balance text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl">
					Tell your browser what to do.<br />
					<span class="text-[var(--color-amber-deep)]">It does the clicking.</span>
				</h1>
				<p class="mt-6 max-w-md text-lg leading-relaxed text-ink-muted">
					Navvy reads any page, decides what to do, and carries out the clicks, typing, and
					navigation for you — by voice or by text, right next to your tabs.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a
						href={INSTALL}
						class="rounded-lg bg-[var(--color-amber)] px-5 py-3 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
						>Add to Chrome</a
					>
					<a href={DOCS} class="rounded-lg border border-cream-200 bg-white/40 px-5 py-3 font-medium text-ink transition-colors hover:bg-white/70">
						Read the docs →
					</a>
				</div>
			</div>

			<!-- Annotated-page mock -->
			<div class="relative">
				<div class="overflow-hidden rounded-2xl border border-cream-200 bg-white shadow-[0_24px_60px_-30px_rgba(28,24,20,0.45)]">
					<div class="flex items-center gap-2 border-b border-cream-200 bg-cream-100 px-4 py-3">
						<span class="size-2.5 rounded-full bg-cream-200"></span>
						<span class="size-2.5 rounded-full bg-cream-200"></span>
						<span class="size-2.5 rounded-full bg-cream-200"></span>
						<span class="ml-3 truncate rounded-md bg-white px-3 py-1 font-mono text-xs text-ink-muted">flights.example.com</span>
					</div>
					<div class="space-y-5 p-6">
						<div class="annot rounded-lg p-3" data-idx="1">
							<div class="font-mono text-xs text-ink-muted">Search</div>
							<div class="mt-1 text-sm">Rome<span class="caret"></span></div>
						</div>
						<div class="flex gap-3">
							<div class="annot flex-1 rounded-lg p-3 text-center text-sm font-medium" data-idx="2">Flights</div>
							<div class="annot flex-1 rounded-lg p-3 text-center text-sm font-medium text-ink-muted" data-idx="3">Hotels</div>
						</div>
						<div class="rounded-lg bg-cream-100 p-3 font-mono text-xs leading-relaxed text-ink-muted">
							<span class="text-[var(--color-amber-deep)]">navvy</span> ▸ type "Rome" into <span class="text-ink">⌜1⌝</span><br />
							<span class="text-[var(--color-amber-deep)]">navvy</span> ▸ click <span class="text-ink">⌜2⌝</span> Flights
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Capabilities -->
		<section id="capabilities" class="mx-auto max-w-6xl px-6 py-20">
			<h2 class="text-3xl font-semibold tracking-tight">One agent, many jobs</h2>
			<p class="mt-3 max-w-lg text-ink-muted">Everything runs in the side panel beside your tabs — no separate app, no remote sandbox.</p>
			<div class="mt-10 grid gap-5 sm:grid-cols-2">
				{
					capabilities.map((c) => (
						<div class="rounded-2xl border border-cream-200 bg-white/50 p-6 transition-colors hover:bg-white">
							<span class="font-mono text-xs text-[var(--color-amber-deep)]">{c.idx}</span>
							<h3 class="mt-2 text-xl font-semibold tracking-tight">{c.title}</h3>
							<p class="mt-2 leading-relaxed text-ink-muted">{c.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- How it works -->
		<section id="how" class="border-y border-cream-200 bg-cream-100/60">
			<div class="mx-auto max-w-6xl px-6 py-20">
				<h2 class="text-3xl font-semibold tracking-tight">How it reads a page</h2>
				<p class="mt-3 max-w-lg text-ink-muted">A perception–reasoning–action loop that works without brittle, hand-written selectors.</p>
				<ol class="mt-10 grid gap-5 md:grid-cols-4">
					{
						steps.map((s, i) => (
							<li class="relative rounded-2xl border border-cream-200 bg-white p-6">
								<span class="font-mono text-xs text-[var(--color-amber-deep)]">{String(i + 1).padStart(2, '0')}</span>
								<h3 class="mt-2 text-lg font-semibold tracking-tight">{s.label}</h3>
								<p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Privacy -->
		<section class="mx-auto max-w-6xl px-6 py-20">
			<div class="grid items-center gap-10 rounded-3xl border border-cream-200 bg-white/50 p-10 lg:grid-cols-[1fr_1.1fr]">
				<div>
					<h2 class="text-3xl font-semibold tracking-tight">Your secrets stay yours</h2>
					<p class="mt-4 leading-relaxed text-ink-muted">
						Save a card number or a password once. Navvy stores it locally, encrypted at rest, and
						types it straight into the page. The model only ever sees an opaque
						<code class="rounded bg-cream-100 px-1.5 py-0.5 font-mono text-sm text-[var(--color-amber-deep)]">{'{{token}}'}</code> —
						never the real value.
					</p>
				</div>
				<div class="rounded-2xl border border-cream-200 bg-white p-6 font-mono text-sm leading-relaxed">
					<div class="text-ink-muted">// what the model receives</div>
					<div class="mt-2">card number: <span class="text-[var(--color-amber-deep)]">{'{{credit_card}}'}</span></div>
					<div class="mt-4 text-ink-muted">// what lands in the page</div>
					<div class="mt-2">card number: •••• •••• •••• 4242</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="mx-auto max-w-6xl px-6 pb-24">
			<div class="rounded-3xl bg-ink px-10 py-16 text-center text-cream">
				<h2 class="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Stop doing the clicking.</h2>
				<p class="mx-auto mt-4 max-w-md text-cream-200/80">Install Navvy and hand the boring parts of the browser to an agent that actually understands the page.</p>
				<a
					href={INSTALL}
					class="mt-8 inline-block rounded-lg bg-[var(--color-amber)] px-6 py-3 font-medium text-cream shadow-sm transition-transform hover:-translate-y-px hover:bg-[var(--color-amber-bright)]"
					>Add to Chrome</a
				>
			</div>
		</section>

		<!-- Footer -->
		<footer class="border-t border-cream-200">
			<div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-ink-muted sm:flex-row">
				<div class="flex items-center gap-2">
					<img src="/logo.svg" alt="" width="20" height="20" />
					<span>Navvy</span>
				</div>
				<nav class="flex items-center gap-5">
					<a href={DOCS} class="transition-colors hover:text-ink">Docs</a>
					<a href={REPO} class="transition-colors hover:text-ink">GitHub</a>
					<a href="/docs/legal/terms-and-privacy" class="transition-colors hover:text-ink">Terms &amp; Privacy</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
